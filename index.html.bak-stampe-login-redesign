<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="STAMPE - Sistema de Gestão de Pedidos" />
    <meta name="theme-color" content="#c1121f" />
    <title>STAMPE</title>
    <style>
      html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        background: #0a0a0a !important;
      }
      #root {
        background: transparent !important;
        position: relative;
        z-index: 1;
        min-height: 100%;
      }
      @keyframes stampeFloat {
        0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.30; }
        25% { transform: translate(50px, -80px) scale(1.15); opacity: 0.40; }
        50% { transform: translate(-30px, 50px) scale(0.85); opacity: 0.25; }
        75% { transform: translate(40px, 80px) scale(1.10); opacity: 0.35; }
      }
    </style>
  </head>
  <body>
    <!-- Fundo visual STAMPE — primeiro filho do body, React fica por cima em z-index 1 -->
    <div id="stampe-bg" style="
      position: fixed;
      inset: 0;
      background: #0a0a0a;
      background-image:
        radial-gradient(circle at 20% 30%, rgba(193, 18, 31, 0.15) 0%, transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(143, 14, 25, 0.12) 0%, transparent 50%);
      pointer-events: none;
    "></div>
    <div id="stampe-glow-1" style="
      position: fixed;
      top: -25%;
      left: -15%;
      width: 55vw;
      height: 55vw;
      background: #c1121f;
      border-radius: 50%;
      filter: blur(140px);
      opacity: 0.35;
      pointer-events: none;
      animation: stampeFloat 18s ease-in-out infinite;
    "></div>
    <div id="stampe-glow-2" style="
      position: fixed;
      bottom: -25%;
      right: -15%;
      width: 45vw;
      height: 45vw;
      background: #8f0e19;
      border-radius: 50%;
      filter: blur(140px);
      opacity: 0.25;
      pointer-events: none;
      animation: stampeFloat 20s ease-in-out infinite reverse;
    "></div>
    <div id="root"></div>
    <script type="module" src="/src/main.tsx"></script>
  </body>
</html>
